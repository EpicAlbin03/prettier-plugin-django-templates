{
  "name": "prettier-plugin-django-templates",
  "version": "0.2.0",
  "description": "Prettier plugin for formatting Django HTML templates",
  "keywords": [
    "django",
    "formatter",
    "html",
    "plugin",
    "prettier",
    "templates"
  ],
  "homepage": "https://github.com/EpicAlbin03/prettier-plugin-django-templates#readme",
  "bugs": {
    "url": "https://github.com/EpicAlbin03/prettier-plugin-django-templates/issues"
  },
  "license": "MIT",
  "author": "Albin Carlsson <inquires@albincarlsson.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EpicAlbin03/prettier-plugin-django-templates.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/plugin.cjs",
  "exports": {
    ".": {
      "types": "./dist/plugin.d.cts",
      "import": "./dist/plugin.cjs",
      "require": "./dist/plugin.cjs",
      "default": "./dist/plugin.cjs"
    },
    "./browser": {
      "types": "./dist/browser.d.mts",
      "default": "./dist/browser.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "test:package": "node test/package-smoke.mjs",
    "benchmark:performance": "vp run build && vp test bench test/performance.bench.ts --reporter=verbose",
    "validate:release": "vp run check && vp run test && vp run build && pnpm pack --dry-run && vp run test:package",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "lint": "vp lint",
    "format": "vp fmt",
    "prepublishOnly": "vp run build",
    "prepare": "vp config",
    "changeset:version": "changeset version && git add --all",
    "changeset:publish": "changeset publish"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@oxlint/plugins": "1.83.0",
    "@types/node": "^25.6.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "oxlint": "1.83.0",
    "prettier": "^3.9.8",
    "publint": "^0.3.24",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "prettier": "^3.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.8.0+sha512.c1f5e7c4cb241c8f174b743851d82f42b802324afc8b0f116b96adb15aa06664948dde36960a3ba1079ba5b4b29dd0140135b94b5b5f5263592249d68e555f26"
}
